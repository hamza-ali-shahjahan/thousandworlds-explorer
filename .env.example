# ThousandWorlds Explorer — accounts (Phase 1)
#
# Copy this file to `.env.local` and fill in the two values from your Supabase
# project: Dashboard → Project Settings → API.
#   - VITE_SUPABASE_URL        = "Project URL"
#   - VITE_SUPABASE_ANON_KEY   = "anon" / "public" API key  (safe to expose in a browser app)
#
# Leave them blank and the explorer runs exactly as before: fully anonymous,
# local-only, no sign-in. See docs/accounts-setup.md for the full walkthrough.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
